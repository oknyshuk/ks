<rml>
	<head>
		<style>
			body {
				font-family: "Liberation Sans";
				width: 220dp;
				height: 220dp;
				position: absolute;
				left: 16dp;
				top: 16dp;
				pointer-events: none;
				border-radius: 4dp;
				background-color: rgba(0, 0, 0, 191);
				border-width: 1dp;
				border-color: rgba(255, 255, 255, 25);
			}
			#container {
				width: 100%;
				height: 100%;
				position: relative;
				overflow: hidden;
			}
			.player {
				width: 6dp;
				height: 6dp;
				position: absolute;
				border-radius: 3dp;
			}
			/* A blip only has a colour once its team is known, which is also what
			   keeps unused player slots invisible. */
			.player-ct {
				background-color: rgba(150, 200, 255, 255);
			}
			.player-t {
				background-color: rgba(255, 200, 80, 255);
			}
			#crosshair-x {
				position: absolute;
				top: 50%;
				left: 0;
				width: 100%;
				height: 1dp;
				background-color: rgba(255, 255, 255, 38);
			}
			#crosshair-y {
				position: absolute;
				left: 50%;
				top: 0;
				width: 1dp;
				height: 100%;
				background-color: rgba(255, 255, 255, 38);
			}
		</style>
	</head>
	<body id="body" data-model="hud"
	      data-style-width="radar.width + 'px'"
	      data-style-height="radar.height + 'px'">
		<div id="container">
			<div id="crosshair-x"/>
			<div id="crosshair-y"/>
			<!-- One div per player slot, instanced once (the array never resizes);
			     rkhud_radar.cpp only moves them and flips their team afterwards.
			     Must not be self-closing: data-for takes the element's inner RML as
			     its template, and a self-closed tag has none. -->
			<div class="player" data-for="blip : radar.blips"
			     data-class-player-ct="blip.shown &amp;&amp; blip.ct"
			     data-class-player-t="blip.shown &amp;&amp; !blip.ct"
			     data-style-left="blip.x + 'px'"
			     data-style-top="blip.y + 'px'"></div>
		</div>
	</body>
</rml>
