#! /usr/bin/env python


def options(opt):
    return


def configure(conf):
    return


def build(bld):
    if bld.env.DEST_OS == "win32":
        return

    libs = []

    includes = ["include"]

    cflags = [
        "-std=c11",
        "-D_POSIX_C_SOURCE=200809L",
        "-Dstatic_array=static",
    ]

    source = [
        "cta.c",
        "displayid.c",
        "dmt-table.c",
        "edid.c",
        "gtf.c",
        "info.c",
        "log.c",
        "memory-stream.c",
        "pnp-id-table.c",
    ]

    bld.stlib(
        source=source,
        target="display-info",
        features="c",
        includes=includes,
        use=libs,
        cflags=cflags,
        subsystem=bld.env.MSVC_SUBSYSTEM,
        idx=bld.get_taskgen_count(),
    )
