export module ks.tier1:iconvar;

import std;
import ks.math;
export import :strtools;

export extern "C++" {

//-----------------------------------------------------------------------------
// Forward declarations
//-----------------------------------------------------------------------------
class IConVar;
class CCommand;

//-----------------------------------------------------------------------------
// ConVar flags
//-----------------------------------------------------------------------------
// The default, no flags at all
inline constexpr int FCVAR_NONE = 0;

// Command to ConVars and ConCommands
// ConVar Systems
inline constexpr auto FCVAR_UNREGISTERED = (1<<0); // If this is set, don't add to linked list, etc.
inline constexpr int FCVAR_DEVELOPMENTONLY = (1<<1);	// Hidden in released products. Flag is removed automatically if ALLOW_DEVELOPMENT_CVARS is defined.
inline constexpr int FCVAR_GAMEDLL = (1<<2);	// defined by the game DLL
inline constexpr int FCVAR_CLIENTDLL = (1<<3);	// defined by the client DLL
inline constexpr int FCVAR_HIDDEN = (1<<4);	// Hidden. Doesn't appear in find or auto complete. Like DEVELOPMENTONLY, but can't be compiled out.

// ConVar only
inline constexpr auto FCVAR_PROTECTED = (1<<5); // It's a server cvar, but we don't send the data since it's a password, etc.  Sends 1 if it's not bland/zero, 0 otherwise as value
inline constexpr auto FCVAR_SPONLY = (1<<6); // This cvar cannot be changed by clients connected to a multiplayer server.
inline constexpr auto FCVAR_ARCHIVE = (1<<7); // set to cause it to be saved to vars.rc
inline constexpr auto FCVAR_NOTIFY = (1<<8); // notifies players when changed
inline constexpr auto FCVAR_USERINFO = (1<<9); // changes the client's info string

inline constexpr auto FCVAR_PRINTABLEONLY = (1<<10); // This cvar's string cannot contain unprintable characters ( e.g., used for player name etc ).

inline constexpr int FCVAR_GAMEDLL_FOR_REMOTE_CLIENTS = (1<<10);	// When on concommands this allows remote clients to execute this cmd on the server. 
														 // We are changing the default behavior of concommands to disallow execution by remote clients without
														 // this flag due to the number existing concommands that can lag or crash the server when clients abuse them.

inline constexpr auto FCVAR_UNLOGGED = (1<<11); // If this is a FCVAR_SERVER, don't log changes to the log file / console if we are creating a log
inline constexpr auto FCVAR_NEVER_AS_STRING = (1<<12); // never try to print that cvar

// It's a ConVar that's shared between the client and the server.
// At signon, the values of all such ConVars are sent from the server to the client (skipped for local
//  client, of course )
// If a change is requested it must come from the console (i.e., no remote client changes)
// If a value is changed while a server is active, it's replicated to all connected clients
inline constexpr auto FCVAR_REPLICATED = (1<<13); // server setting enforced on clients, TODO rename to FCAR_SERVER at some time
inline constexpr int FCVAR_CHEAT = (1<<14);	// Only useable in singleplayer / debug / multiplayer & sv_cheats
inline constexpr auto FCVAR_SS = (1<<15); // causes varnameN where N == 2 through max splitscreen slots for mod to be autogenerated
inline constexpr auto FCVAR_DEMO = (1<<16); // record this cvar when starting a demo file
inline constexpr int FCVAR_DONTRECORD = (1<<17);	// don't record these command in demofiles
inline constexpr auto FCVAR_SS_ADDED = (1<<18); // This is one of the "added" FCVAR_SS variables for the splitscreen players
inline constexpr int FCVAR_RELEASE = (1<<19);	// Cvars tagged with this are the only cvars avaliable to customers
inline constexpr auto FCVAR_RELOAD_MATERIALS = (1<<20); // If this cvar changes, it forces a material reload
inline constexpr auto FCVAR_RELOAD_TEXTURES = (1<<21); // If this cvar changes, if forces a texture reload

inline constexpr auto FCVAR_NOT_CONNECTED = (1<<22); // cvar cannot be changed by a client that is connected to a server
inline constexpr auto FCVAR_MATERIAL_SYSTEM_THREAD = (1<<23); // Indicates this cvar is read from the material system thread
inline constexpr auto FCVAR_ARCHIVE_GAMECONSOLE = (1<<24); // cvar written to config.cfg on the Xbox

inline constexpr int FCVAR_SERVER_CAN_EXECUTE = (1<<28);	// the server is allowed to execute this command on clients via ClientCommand/NET_StringCmd/CBaseClientState::ProcessStringCmd.
inline constexpr auto FCVAR_SERVER_CANNOT_QUERY = (1<<29); // If this is set, then the server is not allowed to query this cvar's value (via IServerPluginHelpers::StartQueryCvarValue).
inline constexpr int FCVAR_CLIENTCMD_CAN_EXECUTE = (1<<30);	// IVEngineClient::ClientCmd is allowed to execute this command. 
											// Note: IVEngineClient::ClientCmd_Unrestricted can run any client command.

inline constexpr auto FCVAR_ACCESSIBLE_FROM_THREADS = (1<<25); // used as a debugging tool necessary to check material system thread convars
// #define FCVAR_AVAILABLE			(1<<26)
// #define FCVAR_AVAILABLE			(1<<27)
// #define FCVAR_AVAILABLE			(1<<31)

inline constexpr int FCVAR_MATERIAL_THREAD_MASK = ( FCVAR_RELOAD_MATERIALS | FCVAR_RELOAD_TEXTURES | FCVAR_MATERIAL_SYSTEM_THREAD );

//-----------------------------------------------------------------------------
// Called when a ConVar changes value
// NOTE: For FCVAR_NEVER_AS_STRING ConVars, pOldValue == NULL
//-----------------------------------------------------------------------------
typedef void ( *FnChangeCallback_t )( IConVar *var, const char *pOldValue, float flOldValue );

//-----------------------------------------------------------------------------
// Abstract interface for ConVars
//-----------------------------------------------------------------------------
class IConVar
{
public:
	// Value set
	virtual void SetValue( const char *pValue ) = 0;
	virtual void SetValue( float flValue ) = 0;
	virtual void SetValue( int nValue ) = 0;
	virtual void SetValue( Color value ) = 0;

	// Return name of command
	virtual const char *GetName( void ) const = 0;

	// Return name of command (usually == GetName(), except in case of FCVAR_SS_ADDED vars
	virtual const char *GetBaseName( void ) const = 0;

	// Accessors.. not as efficient as using GetState()/GetInfo()
	// if you call these methods multiple times on the same IConVar
	virtual bool IsFlagSet( int nFlag ) const = 0;

	virtual int GetSplitScreenPlayerSlot() const = 0;
};

}
