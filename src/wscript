# --- WAF entry points ---


def _vendored(conf, pattern, *subdirs):
    """Absolute paths inside the one vendored tree matching e.g. "dxvk-*"."""
    trees = conf.path.ant_glob("thirdparty/" + pattern, dir=True, src=True, maxdepth=1)
    if len(trees) != 1:
        conf.fatal("expected exactly one thirdparty/%s, found %r" % (pattern, trees))
    return [trees[0].find_dir(s).abspath() for s in subdirs]


def options(opt):
    opt.load("compiler_c compiler_cxx clang_compilation_database pch unity")

    grp = opt.add_option_group("Common options")

    grp.add_option(
        "-T",
        "--build-type",
        action="store",
        dest="BUILD_TYPE",
        default="dev",
        help="build type: dev, release, sanitize, tsan",
    )
    grp.add_option(
        "-w",
        "--no-warnings",
        action="store_true",
        dest="NO_WARNINGS",
        default=False,
        help="disable warnings",
    )
    grp.add_option(
        "--install-instrumented",
        action="store_true",
        dest="INSTALL_INSTRUMENTED",
        default=False,
        help="allow installing a sanitizer build over the shared game prefix",
    )

    opt.parser.get_option("-j").default = DEFAULT_JOBS

    opt.recurse(PROJECTS)


def configure(conf):
    conf.env.BINPATH = conf.env.PREFIX + "/bin"
    conf.env.GAMEBIN = conf.env.PREFIX + "/csgo/bin"

    # --- Compiler detection ---
    conf.load("compiler_c compiler_cxx")

    # --- CCache (auto-enable if on PATH) ---
    ccache_path = shutil.which("ccache")
    if ccache_path:
        conf.env.CC = [ccache_path] + conf.env.CC
        conf.env.CXX = [ccache_path] + conf.env.CXX
        conf.msg("CCache", "enabled")

        base_dir = conf.srcnode.abspath()
        ccache_conf_path = conf.srcnode.make_node("ccache.conf").abspath()
        with open(ccache_conf_path, "w") as f:
            for k, v in {
                "base_dir": base_dir,
                "sloppiness": "include_file_mtime,include_file_ctime,time_macros,file_stat_matches,clang_index_store,locale,random_seed",
                "hash_dir": "false",
                "compression_level": "1",
                "depend_mode": "false",
                "inode_cache": "true",
            }.items():
                f.write(f"{k} = {v}\n")
        os.environ["CCACHE_CONFIGPATH"] = ccache_conf_path
        os.environ["CCACHE_BASEDIR"] = base_dir

    conf.load("clang_compilation_database")
    conf.load("pch")

    # --- PIC for all code ---
    for var in [
        "CFLAGS_cshlib",
        "CXXFLAGS_cxxshlib",
        "CFLAGS_cstlib",
        "CXXFLAGS_cxxstlib",
    ]:
        conf.env.append_unique(var, ["-fPIC"])

    # --- Optimization flags ---
    build_type = conf.options.BUILD_TYPE
    if build_type not in OPTFLAGS:
        conf.fatal(f"Invalid build type '{build_type}'. Valid: {', '.join(OPTFLAGS)}")
    conf.msg("Build type", build_type)
    conf.env.BUILD_TYPE = build_type

    cflags = ["-fvisibility=hidden"] + OPTFLAGS[build_type]
    cxxflags = list(cflags)

    linkflags = list(LINKFLAGS[build_type])
    if shutil.which("mold"):
        linkflags.append("-fuse-ld=mold")

    conf.check_cc(
        cflags=cflags, linkflags=linkflags, msg="Checking for required C flags"
    )
    conf.check_cxx(
        cxxflags=cxxflags, linkflags=linkflags, msg="Checking for required C++ flags"
    )

    conf.env.append_unique("CFLAGS", cflags)
    conf.env.append_unique("CXXFLAGS", cxxflags)
    conf.env.append_unique("LINKFLAGS", linkflags)

    # --- Optional flags ---
    if conf.options.NO_WARNINGS:
        conf.env.append_unique("CFLAGS", ["-w"])
        conf.env.append_unique("CXXFLAGS", ["-w"])

    conf.env.append_unique("CFLAGS", ["-fdiagnostics-color=always"])
    conf.env.append_unique(
        "CXXFLAGS", ["-fdiagnostics-color=always", "-std=c++26", "-freflection"]
    )

    conf.env.append_unique(
        "CXXFLAGS", ["-Wno-invalid-offsetof", "-Wno-free-nonheap-object"]
    )
    # Source Engine was written for MSVC which permits narrowing in brace init
    conf.env.append_unique("CXXFLAGS", ["-Wno-narrowing"])

    # --- Includes ---
    includes = [
        os.path.abspath("public"),
        os.path.abspath("public/tier0"),
        os.path.abspath("public/tier1"),
        os.path.abspath("common"),
    ]

    # --- Defines ---
    conf.define("COMPILER_GCC", True)
    conf.define("_POSIX", True)
    conf.define("POSIX", True)
    conf.define("USE_SDL", True)
    conf.define("_LINUX", True)
    conf.define("LINUX", True)
    conf.define("GNUC", True)
    conf.define("_DLL_EXT", ".so", quote=False)
    conf.define("CSTRIKE15", True)
    conf.define("CSTRIKE_REL_BUILD", True)
    conf.define("VPROF_LEVEL", True)
    conf.define("RAD_TELEMETRY_DISABLED", True)
    conf.define("DX_TO_VK_ABSTRACTION", True)
    conf.define("PLATFORM_64BITS", True)

    if build_type == "debug":
        conf.define("DEBUG", 1)
        conf.define("_DEBUG", 1)
    else:
        conf.define("NDEBUG", 1)

    # --- Dependencies (pkg-config) ---
    conf.check_cfg(package="sdl3", args="--cflags --libs", uselib_store="SDL3")
    includes += conf.env.INCLUDES_SDL3
    conf.check_cfg(package="freetype2", args="--cflags --libs", uselib_store="FREETYPE")
    includes += conf.env.INCLUDES_FREETYPE
    conf.check_cfg(package="zlib", args="--cflags --libs", uselib_store="ZLIB")
    conf.check_cfg(package="libjpeg", args="--cflags --libs", uselib_store="JPEG")
    conf.check_cfg(package="libpng", args="--cflags --libs", uselib_store="PNG")

    # Vendored header directories needed project-wide. The version lives in the
    # directory name, so it is globbed rather than spelled out; see
    # thirdparty/wscript for how the trees are built.
    includes += _vendored(conf, "dxvk-*", "include/native/windows", "include/native/directx")

    conf.env.append_unique("INCLUDES", includes)

    # System includes (suppress warnings in thirdparty headers)
    for sysinc in _vendored(conf, "DirectXMath-*", "Inc"):
        flag = f"-isystem{sysinc}"
        conf.env.append_unique("CFLAGS", [flag])
        conf.env.append_unique("CXXFLAGS", [flag])

    # Target architecture (override via MARCH env var, default: native)
    march = os.environ.get("MARCH", "native")
    conf.env.append_unique("CFLAGS", [f"-march={march}"])
    conf.env.append_unique("CXXFLAGS", [f"-march={march}"])

    root_env = conf.env
    for prj in PROJECTS:
        conf.setenv(prj, root_env.derive())
        conf.recurse(prj)
    conf.setenv("")


def build(bld):
    # Refuse the accident that costs a debugging session: instrumented binaries installed over the
    # dev ones pass every check while the game itself is unusable.
    if bld.is_install and bld.env.BUILD_TYPE in INSTRUMENTED:
        if os.path.abspath(bld.env.PREFIX) == default_prefix and not getattr(
            Options.options, "INSTALL_INSTRUMENTED", False
        ):
            bld.fatal(
                "build type '%s' would install instrumented binaries over the dev prefix %s.\n"
                "Use --prefix=<dir> to install elsewhere, or --install-instrumented to overwrite "
                "the dev binaries deliberately." % (bld.env.BUILD_TYPE, bld.env.PREFIX)
            )

    base_dir = bld.srcnode.abspath()
    ccache_conf_path = bld.srcnode.make_node("ccache.conf").abspath()
    if os.path.exists(ccache_conf_path):
        os.environ["CCACHE_CONFIGPATH"] = ccache_conf_path
        os.environ["CCACHE_BASEDIR"] = base_dir

    root_env = bld.env

    # --- Shared compilation units (compiled once, linked into many targets) ---
    bld.objects(
        source="public/tier0/memoverride.cpp",
        target="memoverride",
        features="cxx",
        idx=bld.get_taskgen_count(),
    )

    bld.stlib(
        source=[
            "public/filesystem_helpers.cpp",
            "public/collisionutils.cpp",
            "public/filesystem_init.cpp",
            "public/imagepacker.cpp",
            "public/networkvar.cpp",
            "public/registry.cpp",
            "public/scratchpad3d.cpp",
            "public/dt_utlvector_common.cpp",
            "public/XZip.cpp",
            "public/XUnzip.cpp",
            "common/steamid.cpp",
            "common/platforminputdevice.cpp",
            "common/randoverride.cpp",
        ],
        target="public_common",
        features="cxx",
        idx=bld.get_taskgen_count(),
    )

    for prj in PROJECTS:
        bld.env = bld.all_envs[prj]
        bld.recurse(prj)
    bld.env = root_env


# --- `waf check`: syntax-only check of locally modified sources -------------
# Far cheaper than a full build, and catches what mechanical source edits break.


class CheckContext(Build.BuildContext):
    """syntax-check sources modified since HEAD (no codegen, no link)"""

    cmd = "check"
    fun = "check"


def check(bld):
    cdb = bld.path.get_bld().find_node("compile_commands.json")
    if not cdb:
        bld.fatal("no compile_commands.json; run `waf build` once first")

    db = {}
    for e in json.loads(cdb.read()):
        cmd = e.get("command") or " ".join(e.get("arguments", []))
        db[os.path.realpath(os.path.join(e.get("directory", "."), e["file"]))] = (
            e.get("directory", "."),
            cmd,
        )

    top = bld.srcnode.parent.abspath()
    changed = subprocess.run(
        ["git", "diff", "--name-only", "HEAD"],
        cwd=top,
        capture_output=True,
        text=True,
    ).stdout.split()

    targets = []
    for f in changed:
        if not f.endswith((".cpp", ".c")):
            continue
        p = os.path.realpath(os.path.join(top, f))
        if os.path.isfile(p) and p in db:
            targets.append(p)

    if not targets:
        Logs.info("check: no modified compilable sources")
        return

    def one(p):
        cwd, cmd = db[p]
        toks = cmd.split()
        argv, skip = [], False
        for t in toks:
            if skip:
                skip = False
                continue
            # a stale PCH is irrelevant to a syntax check, and blocks it
            if t == "-include":
                skip = True
                continue
            if t in ("-c", "-o") or t.endswith((".o", ".pch")):
                continue
            argv.append(t)
        argv.append("-fsyntax-only")
        r = subprocess.run(argv, cwd=cwd, capture_output=True, text=True)
        return p, r.returncode, r.stderr

    bad = 0
    with ThreadPoolExecutor(max_workers=os.cpu_count()) as ex:
        for p, rc, err in ex.map(one, targets):
            if rc:
                bad += 1
                Logs.error("FAIL %s" % os.path.relpath(p, top))
                for line in [x for x in err.splitlines() if " error: " in x][:4]:
                    Logs.error("    " + line.strip())

    Logs.info("check: %d/%d ok" % (len(targets) - bad, len(targets)))
    if bad:
        bld.fatal("%d file(s) failed" % bad)


# --- `waf smoke`: headless regression smoke (symbols + a few seconds of srcds) --
# Every shipped .so is checked for unresolved symbols, then srcds loads a map
# and runs for a few seconds. Catches the "compiles fine, dies on startup" class.
#
#   waf smoke                            de_dust2, 12s (+ client)
#   SECS=30 MAPS="de_nuke cs_office" waf smoke


class SmokeContext(Build.BuildContext):
    """run every shipped .so through ldd -r, then srcds through a few maps"""

    cmd = "smoke"
    fun = "smoke"


# A truncated diff list is worse than none: reading the first few lines and inferring that the
# rest matched is how 30 datamaps got converted on a false premise. So print every gate diff, and
# always print the gate's own summary count -- and dump the whole log where it can be read.
# The engine loads a map and then tears it down on a datatable mismatch. Host_NewGame alone
# therefore proves nothing; these are the aborts worth naming.
def _aborted(log):
    for probe in ("CreateDecoders failed", "Missing RecvProp", "RecvProp type doesn't match",
                  "Host_EndGame"):
        if probe in log:
            for line in log.splitlines():
                if probe in line:
                    return line.strip()[:160]
    return None

def _report(bld, log, tag, con=None):
    from waflib import Logs
    import os, time
    diffs = [l for l in log.splitlines() if "reflect table:" in l]
    path = os.path.join(bld.bldnode.abspath(), "smoke-%s.log" % tag)
    # this file is written only on failure, so a stale copy from an earlier run reads as a
    # current one. Stamp it, and clear any previous copy at the start of every smoke.
    with open(path, "w") as f:
        f.write("=== %s smoke failure, %s ===\n" % (tag, time.strftime("%Y-%m-%d %H:%M:%S")))
        f.write(log)
    shown = diffs if len(diffs) <= 40 else diffs[:40]
    for line in shown:
        Logs.error("       | " + line)
    if len(diffs) > len(shown):
        Logs.error("       | ... %d more gate diffs" % (len(diffs) - len(shown)))
    if diffs:
        Logs.error("       | %d gate diff line(s) total; full log: %s" % (len(diffs), path))
    else:
        for line in ((con or log).splitlines()[-3:]):
            Logs.error("       | " + line)
        Logs.error("       | full log: %s" % path)


def _instrumented(path):
    """True if a binary references a sanitizer runtime."""
    try:
        out = subprocess.run(["nm", "-D", path], capture_output=True, text=True).stdout
    except OSError:
        return False
    return any(s in out for s in ("__tsan_", "__asan_", "__ubsan_"))


def smoke(bld):
    import glob, time
    for stale in glob.glob(os.path.join(bld.bldnode.abspath(), "smoke-*.log")):
        os.remove( stale )
    prefix = bld.env.PREFIX
    srcds = os.path.join(prefix, "srcds")
    if not os.path.isfile(srcds):
        bld.fatal("no srcds at %s; run `waf install` first" % srcds)

    secs = int(os.environ.get("SECS", "12"))
    maps = os.environ.get("MAPS", "de_dust2").split()

    libdirs = [os.path.join(prefix, "bin"), os.path.join(prefix, "csgo", "bin")]
    sos = sorted(
        os.path.join(d, f) for d in libdirs for f in os.listdir(d) if f.endswith(".so")
    )

    # An instrumented prefix still passes this whole check -- the client starts and loads a map -- so
    # the only symptom is a game that freezes when played by hand. Report the real problem instead.
    exes = [os.path.join(prefix, e) for e in ("srcds", "srceng")]
    inst = [f for f in sos + exes if os.path.isfile(f) and _instrumented(f)]
    if inst:
        bld.fatal(
            "prefix %s holds instrumented binaries (%s).\nThis prefix was installed from a "
            "sanitizer build type; reconfigure and rebuild a dev out dir into it before smoking."
            % (prefix, ", ".join(os.path.basename(f) for f in inst[:3]))
        )
    env = dict(os.environ, LD_LIBRARY_PATH=os.pathsep.join(libdirs))

    bad = 0
    for so in sos:
        out = subprocess.run(["ldd", "-r", so], capture_output=True, text=True, env=env).stdout
        hits = [l for l in out.splitlines() if "undefined symbol" in l or "not found" in l]
        if hits:
            bad += 1
            Logs.error("FAIL %s" % so)
            for l in hits[:5]:
                Logs.error("       " + l.strip())
    if not bad:
        Logs.info("ok   %d libraries" % len(sos))

    # servercfgfile is exec'd at level init, after the gamemode cfgs, so it is
    # the only place these stick.
    cfg = os.path.join(prefix, "csgo", "cfg", "ks_smoke.cfg")
    with open(cfg, "w") as f:
        f.write("sv_hibernate_when_empty 0\nbot_join_after_player 0\nbot_quota 10\n")

    try:
        for m in maps:
            argv = [
                srcds, "-game", "csgo", "-console", "-insecure",
                "+sv_lan", "1", "+servercfgfile", "ks_smoke.cfg", "+map", m,
            ]
            def _dec(b):
                if not b: return ""
                return b.decode("utf-8", "replace") if isinstance(b, bytes) else b
            try:
                r = subprocess.run(argv, cwd=prefix, capture_output=True, text=True, errors="replace", timeout=secs)
                # A gate reports on stderr and exits 70. Taking only stdout left a server-side
                # failure as a bare "exit 70" with no diff lines at all.
                rc, log = r.returncode, (r.stdout or "") + (r.stderr or "")
            except subprocess.TimeoutExpired as e:
                rc, log = 124, _dec(e.stdout) + _dec(e.stderr)

            if rc != 124:
                bad += 1
                Logs.error("FAIL %s (exit %s)" % (m, rc))
                _report(bld, log, m)
            elif ("Host_NewGame on map %s" % m) not in log:
                bad += 1
                Logs.error("FAIL %s (never loaded)" % m)
                _report(bld, log, m)
            elif _aborted(log):
                bad += 1
                Logs.error("FAIL %s (loaded then aborted: %s)" % (m, _aborted(log)))
                _report(bld, log, m)
            else:
                Logs.info("ok   %-16s %5d lines" % (m, log.count("\n")))
    finally:
        os.remove(cfg)

    if os.environ.get("DISPLAY") and os.path.isfile(os.path.join(prefix, "srceng")):
        conlog = os.path.join(prefix, "csgo", "console.log")
        at = os.path.getsize(conlog) if os.path.isfile(conlog) else 0
        argv = [
            os.path.join(prefix, "srceng"), "-game", "csgo", "-novid",
            "-windowed", "-w", "640", "-h", "480", "+sv_lan", "1",
            # DevWarning names the offending prop on a decoder mismatch; without this the
            # engine aborts with no clue which table is wrong.
            "-dev", "+developer", "1", "+map", maps[0],
        ]
        try:
            r = subprocess.run(argv, cwd=prefix, capture_output=True, text=True, errors="replace", timeout=secs * 3)
            # A gate aborts through stderr, so dropping it made a gate failure indistinguishable
            # from a silent early exit.
            rc, log = r.returncode, (r.stdout or "") + (r.stderr or "")
        except subprocess.TimeoutExpired as e:
            def dec(b):
                if not b: return ""
                return b.decode("utf-8", "replace") if isinstance(b, bytes) else b
            rc, log = 124, dec(e.stdout) + dec(e.stderr)

        con = ""
        if os.path.isfile(conlog):
            with open(conlog, errors="replace") as f:
                f.seek(at)
                con = f.read()

        rendered = ("Host_NewGame on map %s" % maps[0]) in con
        if not rendered:
            bad += 1
            Logs.error("FAIL client (never rendered %s, exit %s)" % (maps[0], rc))
            _report(bld, log, "client", con)
        elif _aborted(con):
            bad += 1
            Logs.error("FAIL client (loaded then aborted: %s)" % _aborted(con))
            _report(bld, log + "\n" + con, "client", con)
        elif rc < 0:
            Logs.warn("ok   %-16s %5d lines (crashed on shutdown, signal %d)"
                      % ("client", con.count("\n"), -rc))
        else:
            Logs.info("ok   %-16s %5d lines" % ("client", con.count("\n")))

    if bad:
        bld.fatal("smoke: %d check(s) failed" % bad)
    Logs.info("smoke: PASS")
