# --- Build ordering helper (used by all subprojects via idx=) ---


def _get_taskgen_count(self):
    try:
        idx = self.tg_idx_count
    except AttributeError:
        idx = 0
    return idx


Configure.ConfigurationContext.get_taskgen_count = _get_taskgen_count
Build.BuildContext.get_taskgen_count = _get_taskgen_count


# --- Optimization flag tables ---

SANITIZERS = ["-fsanitize=address,undefined", "-pthread"]

TSAN = ["-fsanitize=thread", "-pthread"]

OPTFLAGS = {
    "dev": ["-O1", "-g", "-gsplit-dwarf"],
    # no -ffast-math: under gcc dxbc-spirv shader compiler spins forever translating shaders
    "release": ["-O3", "-flto=auto", "-fno-semantic-interposition"],
    "sanitize": ["-O0", "-g", "-gsplit-dwarf", "-fno-omit-frame-pointer"] + SANITIZERS,
    "tsan": ["-O1", "-g", "-gsplit-dwarf", "-fno-omit-frame-pointer"] + TSAN,
}

LINKFLAGS = {
    "dev": ["-gsplit-dwarf"],
    "release": ["-flto=auto", "-fno-semantic-interposition"],
    "sanitize": ["-gsplit-dwarf"] + SANITIZERS,
    "tsan": ["-gsplit-dwarf"] + TSAN,
}

