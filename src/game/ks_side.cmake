# ks_game_side(<target> <side> <prelude-header> [PRE_INCLUDE <header>...])
#
# Puts every source of the OBJECT library <target> into the inline namespace ks_<side>.  The
# sources stay side-agnostic; the build decides which side they belong to by compiling a generated
# wrapper instead of the file itself:
#
#     <PRE_INCLUDE headers>          // headers that include the standard library textually
#     import std; ...                // everything game code needs
#     #include "<prelude-header>"     // global namespace: the engine-owned headers, shared by all
#     inline namespace ks_<side> {
#     <enter the side's registry>    // statics of the source register with the side
#     #include "<source>"            // game headers and the source itself
#     <leave the registry>
#     }
#
# Everything declared inside the namespace (game headers, inline functions, templates, vtables,
# function-local statics) is mangled with it, so the client and the server define their own copies
# of what they both include, while the prelude (global namespace) is shared with the engine and the
# other side.  In-class member functions stay implicitly inline, so no unit emits a strong copy.
# Because the namespace is inline, ::Name still finds the side's declarations.
#
# What must be declared at global scope (specializations of std templates, extern "C" functions)
# cannot be part of the wrapped code.
function(ks_game_side target side prelude)
    cmake_parse_arguments(PARSE_ARGV 3 _arg "" "" "PRE_INCLUDE")
    set(_pre "")
    foreach(_h IN LISTS _arg_PRE_INCLUDE)
        string(APPEND _pre "#include \"${_h}\"\n")
    endforeach()
    get_target_property(_sources ${target} SOURCES)
    cmake_path(ABSOLUTE_PATH prelude NORMALIZE OUTPUT_VARIABLE _prelude)
    set(_wrapped)
    foreach(_src IN LISTS _sources)
        cmake_path(ABSOLUTE_PATH _src BASE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" NORMALIZE OUTPUT_VARIABLE _abs)
        cmake_path(RELATIVE_PATH _abs BASE_DIRECTORY "${CMAKE_SOURCE_DIR}" OUTPUT_VARIABLE _rel)
        string(REPLACE "/" "__" _flat "${_rel}")
        set(_out "${CMAKE_BINARY_DIR}/ks_wrap/${side}/${_flat}")
        file(CONFIGURE OUTPUT "${_out}" @ONLY NEWLINE_STYLE UNIX CONTENT
"// Generated by ks_game_side(): ${side} wrapper of ${_rel}
${_pre}import std;
import ks.core;
import ks.math;
import ks.tier1;
import ks.vstdlib;
#include \"${_prelude}\"
inline namespace ks_${side} {
namespace { const bool ks_enter_registry = ::ks::enter_registry( ::ks::${side}_registry() ); }
#include \"${_abs}\"
namespace { const bool ks_leave_registry = ::ks::leave_registry(); }
}
")
        list(APPEND _wrapped "${_out}")
    endforeach()
    set_property(TARGET ${target} PROPERTY SOURCES ${_wrapped})
    # the wrappers import std and the ks.* modules
    set_property(TARGET ${target} PROPERTY CXX_SCAN_FOR_MODULES ON)
endfunction()
